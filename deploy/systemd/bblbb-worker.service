# bblbb-worker.service — BBLBB 后台任务 worker（M15-PACKAGE-04）
#
# 与 backend HTTP 进程分离的 worker（`bblbb-backend --worker`）：
#   - 领取 default/mail 队列任务（search.index / markdown.rerender /
#     content.publish / account_deletion / email.deliver）；
#   - SIGTERM 停止领取 → drain_timeout 内收尾在途任务 → 退出（M15-UPGRADE-06）；
#   - 租约到期任务由其他 worker/重启安全重领（不丢任务）。
[Unit]
Description=BBLBB background job worker
Documentation=https://github.com/bblbb/bblbb/blob/main/docs/OPERATIONS.md
After=network-online.target bblbb-backend.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=bblbb
Group=bblbb
WorkingDirectory=/opt/bblbb/current
ExecStart=/opt/bblbb/current/backend/bblbb-backend --worker
EnvironmentFile=/etc/bblbb/backend.env
Environment=BBLBB__SECRETS_SYSTEMD_UNIT=bblbb-worker
LoadCredential=settings_encryption_key:/etc/bblbb/secrets/settings_encryption_key
# Optional credentials use the leading '-' before the credential name.
LoadCredential=-oidc_key_encryption_key:/etc/bblbb/secrets/oidc_key_encryption_key
LoadCredential=-mfa_encryption_key:/etc/bblbb/secrets/mfa_encryption_key
LoadCredential=-marketplace_webhook_encryption_key:/etc/bblbb/secrets/marketplace_webhook_encryption_key
LoadCredential=-s3_access_key_id:/etc/bblbb/secrets/s3_access_key_id
LoadCredential=-s3_secret_access_key:/etc/bblbb/secrets/s3_secret_access_key
LoadCredential=-s3_session_token:/etc/bblbb/secrets/s3_session_token
LoadCredential=-mail_relay_token:/etc/bblbb/secrets/mail_relay_token

# ── 加固（与 backend 一致；worker 不需要监听端口）──────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bblbb /run/bblbb
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
MemoryDenyWriteExecute=true
BindReadOnlyPaths=/etc/bblbb/backend.env

# ── 优雅停机 ───────────────────────────────────────────────
TimeoutStopSec=30
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
