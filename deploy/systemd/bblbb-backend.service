# bblbb-backend.service — BBLBB 后端 HTTP 服务（M15-PACKAGE-04）
#
# 服务用户 bblbb 不可写 release 目录（/opt/bblbb/releases/** 只读）：
# 只可写 /var/lib/bblbb 与 /run（systemd credentials / 运行时文件）。
# 生产必须提供:
#   - /etc/bblbb/backend.env（root:bblbb 0640，非 Secret 配置）
#   - systemd credentials（/run/credentials/bblbb-backend/*）承载 Secret
[Unit]
Description=BBLBB backend HTTP server
Documentation=https://github.com/bblbb/bblbb/blob/main/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=bblbb
Group=bblbb
# current 指向 /opt/bblbb/releases/<version>；发布脚本负责原子切换后重启
WorkingDirectory=/opt/bblbb/current
ExecStart=/opt/bblbb/current/backend/bblbb-backend
EnvironmentFile=/etc/bblbb/backend.env
Environment=BBLBB__SECRETS_SYSTEMD_UNIT=bblbb-backend
# Secret 只经 systemd credentials 注入，不写入 EnvironmentFile。
# credential 名称与 AppConfig secret 字段保持一致。
LoadCredential=settings_encryption_key:/etc/bblbb/secrets/settings_encryption_key
# Optional credentials use the leading '-' before the credential name.
LoadCredential=-oidc_key_encryption_key:/etc/bblbb/secrets/oidc_key_encryption_key
LoadCredential=-mfa_encryption_key:/etc/bblbb/secrets/mfa_encryption_key
LoadCredential=-marketplace_webhook_encryption_key:/etc/bblbb/secrets/marketplace_webhook_encryption_key
LoadCredential=-s3_access_key_id:/etc/bblbb/secrets/s3_access_key_id
LoadCredential=-s3_secret_access_key:/etc/bblbb/secrets/s3_secret_access_key
LoadCredential=-s3_session_token:/etc/bblbb/secrets/s3_session_token
LoadCredential=-mail_relay_token:/etc/bblbb/secrets/mail_relay_token

# ── 加固 ────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bblbb /run/bblbb
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
MemoryDenyWriteExecute=true
# Secret 目录只读
BindReadOnlyPaths=/etc/bblbb/backend.env

# ── 优雅停机（M15-UPGRADE-06）──────────────────────────────
TimeoutStopSec=30
KillSignal=SIGTERM
# 重启策略：崩溃自动拉起；反复崩溃进入 failed 由监控告警
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
