# BBLBB Caddy 生产模板（M15-PACKAGE-03）
#
# 复制为 /etc/caddy/Caddyfile 并替换占位符：
#   - community.example.com → 正式域名
#   - 127.0.0.1:8080 / 127.0.0.1:3000 → backend / frontend 监听地址
#
# 安全要点：
#   - TLS 自动（Caddy 内置 ACME）；HTTP → HTTPS 自动 301；
#   - 安全头 + CSP（与 SvelteKit 构建产物兼容的默认值，允许按需收紧）；
#   - 压缩（zstd/gzip，Caddy 对文本默认）；
#   - 请求体上限（前端 10MB；与 backend BODY_LIMIT=10MB 双层限制）；
#   - 可信代理：client IP 只信任回环/本机链；
#   - /readyz 与 /metrics 不对外代理：仅供本机/受控监控（M15-PACKAGE-07）。
{
	admin 127.0.0.1:2019
	# 生产建议把 admin 端点绑定到 loopback 或关闭：localhost:2019
}

# 内置监控路径：本机/受控监控使用（不暴露公网）。
# 例如 Prometheus 直接从 http://127.0.0.1:8080/metrics 抓取（loopback）。
# Caddy 不做公网代理，配合 backend 的 loopback-only 校验（M15-PACKAGE-07）。

community.example.com {
	encode zstd gzip

	# ── 安全头 ──────────────────────────────────────────────
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		# CSP 与 SvelteKit 构建产物兼容的最小集合；上线前按实际资源收紧
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-XSS-Protection "0"
	}

	# ── 可信代理声明：只信任本机 Caddy → backend 链 ─────────
	# backend 自行按 loopback-only 处理（生产 BIND 必须 loopback）。
	# 如需记录真实客户端 IP，由 backend 从 X-Forwarded-For 首个非可信跳
	# 读取；Caddy 侧不引入第三方代理。

	# ── 静态资源缓存 ────────────────────────────────────────
	@static path /_app/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# ── API 反向代理 ────────────────────────────────────────
	@backend path /api/v1/* /.well-known/* /oauth/* /healthz
	reverse_proxy @backend 127.0.0.1:8080 {
		# 请求体上限：与 backend BODY_LIMIT=10MB 一致（双层限制）
		request_body {
			max_size 10MB
		}
	}

	# ── 前端 SSR ────────────────────────────────────────────
	reverse_proxy 127.0.0.1:3000 {
		request_body {
			max_size 10MB
		}
	}

	# ── 记录访问日志（不含 Cookie/Authorization，见日志脱敏策略）──
	log {
		output stdout
		format json
	}
}

# ── HTTP→HTTPS ──────────────────────────────────────────────
# Caddy 默认自动把 http://community.example.com 301 到 https://。
# 显式声明（可选）：
# http://community.example.com {
# 	redir https://community.example.com{uri} permanent
# }
