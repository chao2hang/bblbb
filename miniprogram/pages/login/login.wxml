<view class="page login-page">
  <view class="login-hero">
    <view class="login-logo">B</view>
    <view class="title">{{step === 'password' ? '登录 BBLBB' : '两步验证'}}</view>
    <view class="subtitle" wx:if="{{step === 'password'}}">社区论坛 · 文章与讨论</view>
    <view class="subtitle" wx:else>请输入 Authenticator 验证码或恢复码</view>
  </view>

  <view class="card login-card">
    <!-- 第一步：账号密码 -->
    <block wx:if="{{step === 'password'}}">
      <view class="field">
        <text class="field-label">用户名或邮箱</text>
        <input
          class="input"
          value="{{identifier}}"
          data-field="identifier"
          bindinput="onInput"
          placeholder="请输入用户名或邮箱"
          placeholder-class="ph"
          confirm-type="next"
        />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input
          class="input"
          value="{{password}}"
          data-field="password"
          bindinput="onInput"
          placeholder="请输入密码"
          placeholder-class="ph"
          password
          confirm-type="go"
          bindconfirm="onSubmit"
        />
      </view>

      <view class="row-between remember-row">
        <label class="remember">
          <checkbox value="remember" checked="{{remember}}" bindchange="onRemember" color="#E45735" />
          <text class="remember-text">记住我（30 天会话）</text>
        </label>
        <text class="text-2 forgot-link" bindtap="goForgot">忘记密码？</text>
      </view>

      <button class="btn btn-primary btn-block mt-24" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
        登录
      </button>
      <view class="form-hint register-hint" bindtap="goRegister">还没有账号？去注册</view>
    </block>

    <!-- 第二步：MFA -->
    <block wx:else>
      <view class="field">
        <text class="field-label">{{usingRecovery ? '恢复码' : '6 位验证码'}}</text>
        <input
          class="input mfa-input"
          value="{{mfaCode}}"
          data-field="mfaCode"
          bindinput="onInput"
          placeholder="{{usingRecovery ? '请输入恢复码' : '如 123456'}}"
          placeholder-class="ph"
          maxlength="32"
          confirm-type="go"
          bindconfirm="onSubmit"
        />
      </view>
      <button class="btn btn-primary btn-block" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
        完成验证
      </button>
      <view class="form-hint mfa-switch" bindtap="onSwitchMfa">
        {{usingRecovery ? '改用 Authenticator 验证码' : '输入恢复码'}}
      </view>
      <view class="form-hint mfa-back" bindtap="onBackToPassword">← 返回上一步</view>
    </block>

    <view class="login-error" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
