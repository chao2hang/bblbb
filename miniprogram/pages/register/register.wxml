<view class="page">
  <view class="container">
    <view class="reg-head">
      <view class="title">创建账号</view>
      <view class="subtitle mt-16">加入 BBLBB，开启社区之旅</view>
    </view>

    <view class="card mt-32">
      <view class="field">
        <text class="field-label">用户名</text>
        <input class="input" value="{{username}}" data-field="username" bindinput="onInput"
          placeholder="3-20 位字母/数字/_/-" placeholder-class="ph" maxlength="20" />
      </view>
      <view class="field">
        <text class="field-label">邮箱</text>
        <input class="input" value="{{email}}" data-field="email" bindinput="onInput"
          placeholder="用于登录与验证" placeholder-class="ph" type="text" />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input class="input" value="{{password}}" data-field="password" bindinput="onInput"
          placeholder="8-128 位，须含字母与数字" placeholder-class="ph" password />
      </view>
      <view class="field">
        <text class="field-label">确认密码</text>
        <input class="input" value="{{confirm}}" data-field="confirm" bindinput="onInput"
          placeholder="再次输入密码" placeholder-class="ph" password confirm-type="go"
          bindconfirm="onSubmit" />
      </view>

      <button class="btn btn-primary btn-block mt-24" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
        注册
      </button>

      <view class="form-hint reg-login" bindtap="goLogin">已有账号？去登录</view>
      <view class="reg-error" wx:if="{{error}}">{{error}}</view>
    </view>
  </view>
</view>
