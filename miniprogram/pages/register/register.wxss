.reg-head {
  padding-top: 32rpx;
}

.agreement {
  margin-top: 24rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
}

.agreement-label {
  display: flex;
  align-items: center;
  color: var(--ink-2);
  font-size: 26rpx;
}

.rules-link {
  margin-left: 8rpx;
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.reg-login {
  text-align: center;
  margin-top: 28rpx;
  color: var(--accent);
}

.reg-error {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: 12rpx;
  font-size: 26rpx;
}

.ph {
  color: var(--ink-3);
}
