.rules-head {
  padding: 32rpx 0 36rpx;
  border-bottom: 1rpx solid var(--line);
}

.rules-kicker {
  display: block;
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.rules-version {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}

.rules-section {
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rules-section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.rules-item {
  position: relative;
  margin-top: 16rpx;
  padding-left: 28rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.8;
}

.rules-item::before {
  position: absolute;
  top: 17rpx;
  left: 4rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--accent);
  content: '';
}

.rules-note {
  margin-top: 32rpx;
  padding: 24rpx;
  border-left: 6rpx solid var(--accent);
  background: var(--accent-soft);
  color: var(--ink);
  font-size: 25rpx;
  line-height: 1.8;
}
