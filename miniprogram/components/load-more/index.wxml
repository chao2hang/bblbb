<view class="lm" wx:if="{{hasMore || loading || error}}">
  <view wx:if="{{loading}}" class="lm-center">
    <view class="spin spin-sm"></view>
    <text class="text-3 lm-text">加载中…</text>
  </view>
  <view wx:elif="{{error}}" class="lm-center" bindtap="onRetry">
    <text class="text-accent lm-text">加载失败，点击重试</text>
  </view>
  <view wx:else class="lm-center">
    <text class="text-3">上拉加载更多</text>
  </view>
</view>
<view class="lm" wx:else>
  <view class="lm-center">
    <text class="text-3">— 已加载全部 —</text>
  </view>
</view>
