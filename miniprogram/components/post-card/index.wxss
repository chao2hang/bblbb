.pc {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.pc-hover {
  opacity: 0.85;
}

.pc-top {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.pc-badges {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.pc-title {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
  flex: 1;
}

.pc-summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.pc-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.pc-author {
  font-size: 24rpx;
  color: var(--ink-2);
  max-width: 200rpx;
}

.pc-type {
  font-size: 20rpx;
}

.pc-stats {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}
