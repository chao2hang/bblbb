FROM rust:1-bookworm AS backend-deps
WORKDIR /src/backend
COPY backend/Cargo.toml backend/Cargo.lock ./
# Compile only the dependency graph in a cacheable layer. The real source is
# copied in the next stage, so ordinary Rust source changes do not invalidate
# the expensive crates.io/git dependency build.
RUN mkdir -p src/bin \
    && printf 'pub fn __dependency_probe() {}\n' > src/lib.rs \
    && printf 'fn main() {}\n' > src/main.rs \
    && printf 'fn main() {}\n' > src/bin/migrate.rs
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --release --locked --bin bblbb-backend --bin bblbb-migrate \
    && rm -rf target/release/.fingerprint/bblbb-* target/release/deps/libbblbb* target/release/deps/bblbb-* target/release/bblbb-backend target/release/bblbb-migrate

FROM rust:1-bookworm AS backend-build
WORKDIR /src/backend
# 纵深防御：CARGO_TARGET_DIR 环境变量优先于 .cargo/config.toml 的
# build.target-dir，保证产物始终落在 /src/backend/target（.dockerignore
# 已排除 backend/.cargo，这里兜底未来 context 变化）。
ENV CARGO_TARGET_DIR=/src/backend/target
COPY --from=backend-deps /usr/local/cargo /usr/local/cargo
COPY --from=backend-deps /src/backend/Cargo.toml /src/backend/Cargo.lock ./
COPY --from=backend-deps /src/backend/target ./target
COPY backend ./
COPY frontend/src/lib/data /src/frontend/src/lib/data
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo build --release --locked --bin bblbb-backend --bin bblbb-migrate

FROM node:22-bookworm-slim AS frontend-build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend ./
RUN npm run build
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --create-home --home-dir /app bblbb
WORKDIR /app
COPY --from=backend-build /src/backend/target/release/bblbb-backend /app/bin/bblbb-backend
COPY --from=backend-build /src/backend/target/release/bblbb-migrate /app/bin/bblbb-migrate
COPY --from=frontend-build /src/frontend/build /app/frontend/build
COPY --from=frontend-build /src/frontend/node_modules /app/frontend/node_modules
COPY --from=frontend-build /src/frontend/package.json /src/frontend/package-lock.json /app/frontend/
COPY migrations /app/migrations
COPY openapi /app/openapi
COPY Docker/entrypoint.sh /app/entrypoint.sh
RUN chmod 0755 /app/entrypoint.sh /app/bin/* && chown -R bblbb:bblbb /app
USER bblbb
ENV BBLBB__BIND_ADDRESS=0.0.0.0:8080
ENV BBLBB__MIGRATIONS_DIR=/app/migrations/mariadb
ENV BBLBB__OPENAPI_PATH=/app/openapi/openapi.yaml
ENV BBLBB__STORAGE_DIR=/app/uploads
EXPOSE 8080 3000
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["frontend"]
