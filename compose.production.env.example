# Copy to .env on the deployment host, fill real values, and protect with chmod 0600.
# The production Docker image sets BBLBB__ENV=production and containerized=true.
# Missing/placeholder secrets intentionally make the backend fail closed.
BBLBB__ENV=production
BBLBB__CONTAINERIZED=true
BBLBB__DATABASE_URL=mysql://bblbb:CHANGE_ME@db.internal:3306/bblbb
# Generate a unique random 32-byte key (hex) and store it separately from DB backups.
BBLBB__SETTINGS_ENCRYPTION_KEY=
BBLBB__MFA_ENCRYPTION_KEY=
BBLBB__PUBLIC_ORIGIN=https://community.example.com
BBLBB__ALLOWED_ORIGINS=https://community.example.com
BBLBB__ALLOWED_HOSTS=community.example.com
BBLBB__AUTO_MIGRATE=false
BBLBB__MIGRATIONS_DIR=/app/migrations/mariadb
BBLBB__STORAGE_BACKEND=local
BBLBB__STORAGE_DIR=/app/uploads
# For S3, configure credentials and provider integration only after M06-UPLOAD-03 is cleared.
# BBLBB__STORAGE_BACKEND=s3
# BBLBB__S3_BUCKET=...
# BBLBB__S3_REGION=...
